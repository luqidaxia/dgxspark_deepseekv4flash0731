# Worker node env for spark-cefb
NODE_RANK=1
HEADLESS=1
MASTER_ADDR=10.10.12.11
MASTER_PORT=25000
VLLM_HOST_IP=10.10.12.21

NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
# 启动脚本会根据 show_gids 自动计算 v2 GID index；下面是 fallback 值。
NCCL_IB_GID_INDEX=6
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1

DSPARK_VLLM_IMAGE=ghcr.nju.edu.cn/anemll/dspark-vllm-gx10:0.1.1
DSPARK_MODEL_HOST=/data/models/deepseek-ai/DeepSeek-V4-Flash-0731
HF_CACHE=/root/.cache/huggingface
DSPARK_TMP_HOST=/var/lib/dspark-tmp
SERVED_MODEL_NAME=deepseek-v4-flash

MAX_MODEL_LEN=350000
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5
JIT_MONITOR_MODE=warn
